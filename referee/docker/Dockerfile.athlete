FROM python:3.12-slim

RUN groupadd --gid 10001 athlete && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin athlete && \
    mkdir -p /workspace /tmp/athlete && \
    chown -R 10001:10001 /workspace /tmp/athlete

RUN pip install --no-cache-dir numpy==2.2.6 pillow==11.2.1

WORKDIR /workspace
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    HOME=/tmp/athlete \
    TMPDIR=/tmp/athlete

ENTRYPOINT ["python", "-u"]
